{
  "name": "@infinity/app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "infinity Gauntlet Love Letter - Multiplayer Game Backend",
  "scripts": {
    "start": "NODE_ENV=production node build/bin/server.js",
    "build": "node ace build",
    "clean": "rm -rf .turbo node_modules build",
    "dev": "DEV_MODE=true node ace serve --hmr",
    "game:demo:rps": "node ace game:demo:rps",
    "test": "node ace test",
    "test:watch": "node ace test --watch",
    "test:coverage": "c8 --include=app/** --exclude=app/**/*.spec.ts node ace test",
    "test:unit": "node ace test unit",
    "test:integration": "node ace test integration",
    "test:functional": "node ace test functional",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#contracts/*": "./app/contracts/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#domain/*": "./app/domain/*.js",
    "#shared/*": "./app/domain/shared/*.js",
    "#factories/*": "./database/factories/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#repositories/*": "./app/repositories/*.js",
    "#utils/*": "./app/utils/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#games/*": "./app/games/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#infrastructure/*": "./app/infrastructure/*.js",
    "#application/*": "./app/application/*.js",
    "#application/repositories/*": "./app/application/repositories/*.js",
    "#application/services/*": "./app/application/services/*.js",
    "#application/use_cases/*": "./app/application/use_cases/*.js",
    "#application/dtos/*": "./app/application/dtos/*.js",
    "#application/serializers/*": "./app/application/serializers/*.js",
    "#presenters/*": "./app/presenters/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/eslint-config": "^3.0.0",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.1.0",
    "@japa/runner": "^4.5.0",
    "@poppinss/file-generator": "^2.1.6",
    "@poppinss/ts-exec": "^1.4.4",
    "@stryker-mutator/core": "^9.5.1",
    "@stryker-mutator/typescript": "^4.0.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.19.11",
    "@vitejs/plugin-react": "^5.1.4",
    "better-sqlite3": "^11.10.0",
    "c8": "^10.1.3",
    "eslint": "^9.39.2",
    "hot-hook": "^0.4.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "sinon": "^21.0.1",
    "sinon-test": "^3.1.6",
    "typescript": "~5.7.3",
    "vite": "^7.3.1",
    "youch": "^4.1.0"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.0.0",
    "@adonisjs/core": "^7.0.1",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/drive": "^4.0.0",
    "@adonisjs/inertia": "^4.1.0",
    "@adonisjs/lucid": "^22.0.0",
    "@adonisjs/session": "^8.0.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.0",
    "@adonisjs/transmit": "^3.0.1",
    "@adonisjs/transmit-client": "^1.1.0",
    "@adonisjs/vite": "^5.1.0",
    "@inertiajs/core": "^2.3.17",
    "@inertiajs/react": "^2.3.17",
    "@infinity.dev/events": "1.0.0",
    "@infinity.dev/game-engine": "1.0.0",
    "@infinity.dev/transcript": "1.0.0",
    "@infinity.dev/ui": "1.0.0",
    "@tailwindcss/vite": "^4.1.18",
    "@vinejs/vine": "^4.3.0",
    "adonisjs-server-stats": "^1.2.2",
    "edge.js": "^6.5.0",
    "effect": "^3.16.11",
    "lucide-react": "^0.475.0",
    "luxon": "^3.7.2",
    "mysql2": "^3.20.0",
    "reflect-metadata": "^0.2.2",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7"
  },
  "peerDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
