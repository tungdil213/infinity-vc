TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development
SESSION_DRIVER=cookie
VITE_APP_NAME=infinity.dev

# Database
DB_CONNECTION=sqlite
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_DATABASE=infinity.dev
DRIVE_DISK=fs

TEST_TMP_DIR=/tmp/infinity.dev

# RBAC
# ADMIN_EMAILS=admin@example.com
# MODERATOR_EMAILS=moderator@example.com

# Lobby presence / reconnect robustness
# Delay before removing a disconnected player from a lobby (milliseconds)
# Recommended: 30000-60000
# LOBBY_DISCONNECT_GRACE_MS=45000

# Replay signing / rotation / strict mode
# Dedicated active key (fallback is APP_KEY when omitted)
# REPLAY_SIGNING_KEY=
# REPLAY_SIGNING_KEY_ID=replay-v1
#
# Previous keys allowed for verification only.
# Format: keyId:secret,keyId2:secret2
# REPLAY_SIGNING_PREVIOUS_KEYS=
#
# After legacy migration, enable strict signature requirement on replay reads
# REPLAY_REQUIRE_SIGNATURES=false
