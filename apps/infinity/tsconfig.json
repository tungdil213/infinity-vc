{
  "extends": "@adonisjs/tsconfig/tsconfig.app.json",
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./build",
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true
  },
  "exclude": [
    "./inertia/**/*",
    "./resources/**/*",
    "./releases/**/*",
    "./current/**/*",
    "./database/samples/**/*",
    "./app/tests/**/*",
    "./tests/unit/inertia/**/*",
