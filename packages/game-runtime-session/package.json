{
  "name": "@infinity.dev/game-runtime-session",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Game runtime orchestration and in-memory session lifecycle",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./service": {
      "types": "./dist/game_engine_service.d.ts",
      "import": "./dist/game_engine_service.js"
    },
    "./store": {
      "types": "./dist/game_session_store.d.ts",
      "import": "./dist/game_session_store.js"
    },
    "./events": {
      "types": "./dist/game_engine_event_publisher.d.ts",
      "import": "./dist/game_engine_event_publisher.js"
    },
    "./types": {
      "types": "./dist/game_engine_types.d.ts",
      "import": "./dist/game_engine_types.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "clean": "rm -rf dist .turbo node_modules",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@infinity.dev/events": "1.0.0",
    "@infinity.dev/game-engine": "1.0.0",
    "@infinity.dev/lobby-application": "1.0.0",
    "@infinity.dev/lobby-domain": "1.0.0",
    "effect": "^3.16.11"
  },
  "devDependencies": {
    "@infinity.dev/typescript-config": "1.0.0",
    "typescript": "~5.7.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
